# Copy to .env and fill in. Never commit the filled-in file; .gitignore already excludes it.

# Required. https://app.zenrows.com/register
ZENROWS_API_KEY=

# Required. https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# Required. https://www.crawlforge.dev/
CRAWLFORGE_API_KEY=

# Optional. Jina AI Reader serves unauthenticated requests at a lower rate limit.
# https://jina.ai/reader/
JINA_API_KEY=
